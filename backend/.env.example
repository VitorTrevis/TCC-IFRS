# Porta do servidor Express
PORT=3000

# Caminho do arquivo SQLite (relativo a pasta backend)
DB_FILE=campeonatos.db

# Segredo usado para assinar os tokens de login. Troque por um valor aleatorio.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=8h

# Senha unica da coordenacao (admin). Quem souber esta senha consegue criar,
# editar e apagar campeonatos, times e placares.
ADMIN_PASSWORD=ifrs2026

# --- Autocadastro de alunos por e-mail institucional ---

# Dominio de e-mail aceito no autocadastro. So quem tiver um e-mail terminado
# nisso consegue criar conta de aluno.
DOMINIO_EMAIL_ALUNO=aluno.farroupilha.ifrs.edu.br

# Conta Gmail que envia o e-mail de confirmacao. NAO use a senha normal da
# conta: gere uma "senha de app" em https://myaccount.google.com/apppasswords
# (precisa ter verificacao em duas etapas ativada na conta Google).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL publica do sistema, usada para montar o link de confirmacao no e-mail.
# Localmente costuma ser http://localhost:3000; em producao, o link do deploy.
APP_URL=http://localhost:3000

# Se GMAIL_USER/GMAIL_APP_PASSWORD ficarem vazios, o sistema nao trava: o link
# de confirmacao e so impresso no console do servidor, util para testar sem
# mandar e-mail de verdade.

# --- Banco Turso (so em producao, ex: Vercel) ---
# Local, deixe vazio: o sistema usa o arquivo campeonatos.db normalmente.
# Em producao, preencha com os dados de um banco criado em https://turso.tech
# (plano gratuito) - sem isso, um ambiente serverless perde os dados escritos
# a cada "cold start" da funcao.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
